# Livepeer Agent (https://agent.livepeer.org/get-started.html)
# Hackathon: use the creative harness — $100 balance per hacker, re-ups every 24h.
# Do not set LIVEPEER_AGENT_KEY (Daydream sk_ keys are not accepted on Agent).
LIVEPEER_AGENT_URL=https://agent.livepeer.org/api/mcp/creative

# Soft pastel house look without uploading a Reference each time.
# Leave empty to auto-upload public/house-style.jpg once per process.
# Set HOUSE_STYLE=0 to disable the default style cast (plain flux-dev).
HOUSE_STYLE_URL=
HOUSE_STYLE=

# Set to 1 to run the whole studio without spending anything, on the bundled
# placeholder frame and film. Useful for UI work and as a demo safety net.
MOCK_AGENT=
